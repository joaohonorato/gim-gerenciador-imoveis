# Copy this file to deploy/.env.azure and fill in before running
# deploy/azure-setup.sh. deploy/.env.azure is gitignored — never commit
# real values.

# --- Azure resource names (script creates these; change if they collide) ---
# eastus2 chosen to match Supabase's region (aws us-east-2) — backend<->DB
# latency matters more than user<->backend latency for a Hibernate/JPA app.
# Also required: it's one of the few regions Static Web Apps supports, and
# at time of writing eastus itself was out of AKS capacity for Container Apps.
AZURE_LOCATION=eastus2
AZURE_RESOURCE_GROUP=gim-gerenciador-imoveis-rg
AZURE_CONTAINERAPPS_ENV=gim-containerapps-env
AZURE_CONTAINER_APP_NAME=gim-backend
AZURE_STATIC_WEB_APP_NAME=gim-frontend
AZURE_LANDING_APP_NAME=gim-landing
AZURE_SP_NAME=gim-gerenciador-imoveis-deploy

# owner/repo — where the script pushes GitHub Secrets via `gh secret set`
GITHUB_REPO=joaohonorato/gim-gerenciador-imoveis

# --- Custom domain (optional — leave DOMAIN_NAME blank to skip entirely) ---
# Domain must already be registered elsewhere (e.g. Squarespace) — this only
# creates an Azure DNS zone and delegates to it. You still have to update
# the domain's nameservers at your registrar to the ones Azure assigns;
# deploy/azure-custom-domain.sh prints them and waits for propagation.
#
# DOMAIN_NAME itself (apex, no subdomain) goes to AZURE_LANDING_APP_NAME —
# a Static Web App only ever serves one piece of content across all its
# custom domains, so the marketing landing page and the real app can't
# share a Static Web App resource. FRONTEND_SUBDOMAIN goes to
# AZURE_STATIC_WEB_APP_NAME (the actual app), BACKEND_SUBDOMAIN to the API.
DOMAIN_NAME=
FRONTEND_SUBDOMAIN=app
BACKEND_SUBDOMAIN=api

# --- Supabase (create the project yourself first — needs your account) ---
# Project Settings -> Database -> Connection pooling -> Session mode (port 5432)
SUPABASE_DB_HOST=
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=
SUPABASE_DB_NAME=postgres

# --- Optional: real email delivery (leave blank to skip) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@imoveis.local
